<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Remaining track -->
    <item android:id="@android:id/background"  android:right="18dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/grey" />
            <stroke
                android:width="2dp"
                android:color="@color/grey"
               />
        </shape>

    </item>

    <!-- 2. Triangle capping the right end -->
    <item
        android:id="@android:id/background"
        android:gravity="end|center_vertical"
        android:width="18dp"
        android:height="18dp">
        <vector
            android:width="18dp"
            android:height="18dp"
            android:viewportWidth="14"
            android:viewportHeight="14">
            <path
                android:fillColor="@color/grey"
                android:pathData="
                    M0,0 L14,0 L14,2 L12,2 L12,4 L10,4 L10,6
                    L8,6 L8,8 L6,8 L6,10 L4,10 L4,12 L2,12
                    L2,14 L0,14 Z" />
        </vector>
    </item>

    <!-- Played track -->
    <item android:id="@android:id/progress" android:right="18dp">
        <clip>
            <shape android:shape="rectangle" android:right="18dp">
                <size android:height="4dp" />
                <solid android:color="@color/blue" />
            </shape>
        </clip>
    </item>


</layer-list>