<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="@drawable/dashed_border"
    android:layout_marginTop="5dp"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp"
    android:paddingVertical="0dp"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:layout_width="45dp"
        android:layout_height="55dp"
        android:id="@+id/icon_view"
        android:layout_marginStart="5dp"
        android:layout_marginVertical="5dp"
        android:contentDescription="@string/music_cover"
        android:src="@drawable/music_icon_small"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:id="@+id/song_number_text"
        android:fontFamily="@font/eightbitoperator_jve"
        android:textColor="@color/color"
        android:alpha="0.6"
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="0dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        tools:text="01" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:fontFamily="@font/eightbitoperator_jve"
        android:background="@drawable/dashed_left_border"
        android:textColor="@color/color"
        android:id="@+id/music_title_text"
        android:paddingVertical="20dp"
        android:paddingStart="10dp"
        android:paddingEnd="0dp"
        android:maxLines="1"
        android:layout_marginVertical="0dp"
        android:textSize="16sp"
        android:ellipsize="end"
        tools:text="Music" />

</LinearLayout>