<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/nav_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:padding="4dp">

        <TextView
            android:id="@+id/songs_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/eightbitoperator_jve"
            android:text="@string/folders"
            android:textSize="25sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
             />

        <Button
            android:id="@+id/scanFolders_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:fontFamily="@font/eightbitoperator_jve"
            android:textSize="18sp"
            android:text="@string/scan_folders"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/dashed_border"
            android:elevation="0dp" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/folder_recyclerview"
        tools:context=".fragment.FolderFragment"
        android:layout_below="@id/nav_list"
        tools:listitem="@layout/fragment_folder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <TextView
        android:id="@+id/empty_folders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/nav_list"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:fontFamily="@font/eightbitoperator_jve"
        android:text="No music folders found\n\nPress SCAN FOLDERS to find music"
        android:textSize="25sp"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />
</RelativeLayout>